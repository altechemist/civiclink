rules_version = '2';

// CivicLink Storage Security Rules (BR-02, BR-09, BR-17).
// Uploads: images only, at most 5 MB, into the uploader's own folder. Functions verify the paths again.
service firebase.storage {
  match /b/{bucket}/o {

    function active() { return request.auth != null && request.auth.token.active == true; }
    function role() { return request.auth.token.role; }
    function isStaff() { return active() && role() in ['OFFICIAL', 'FIELD_WORKER', 'ADMIN']; }
    function validImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Report evidence: reports/{residentUid}/{file}
    match /reports/{uid}/{file} {
      allow create: if active() && role() == 'RESIDENT' && request.auth.uid == uid && validImage();
      allow read: if (active() && request.auth.uid == uid) || isStaff();
    }

    // Completion proof: proofs/{reportId}/{workerUid}/{file}
    match /proofs/{reportId}/{uid}/{file} {
      allow create: if active() && role() == 'FIELD_WORKER' && request.auth.uid == uid && validImage();
      allow read: if isStaff()
        || (active() && firestore.get(/databases/(default)/documents/reports/$(reportId)).data.reporterId == request.auth.uid);
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
