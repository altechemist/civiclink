@startuml data-model
!include _style.iuml
title CivicLink: Firestore Document Model (implemented)
hide circle
skinparam linetype ortho

entity "users/{uid}" as users {
  * uid : string <<PK, = Auth uid>>
  --
  * name : string
  * email : string <<unique via Auth>>
  phone : string
  smsAlerts : boolean
  isGuest : boolean
  * role : RESIDENT|OFFICIAL|FIELD_WORKER|ADMIN
  departmentId : string <<FK departments>>
  suburb : string
  * isActive : boolean
  * createdAt : timestamp
  lastLoginAt : timestamp
}
entity "users/{uid}/notifications/{id}" as notif {
  * id <<PK>>
  --
  * type, title, body, link : string
  readAt : timestamp
  * createdAt : timestamp
}
entity "reports/{id}" as reports {
  * id : string <<PK>>
  --
  * ref : string <<unique, counter>>
  * reporterId : string <<FK users>>
  * categoryId : string <<FK categories>>
  * departmentId : string <<FK departments>>
  * description : string (10–300)
  * location : {lat,lng}
  * geohash : string <<indexed>>
  * suburb : string
  * severity : HIGH|MEDIUM|LOW
  * photoIds : string[0..3] <<FK photos>>
  * status : ReportStatus
  assignedWorkerId : string <<FK users>>
  activeTaskId : string <<FK tasks>>
  parentReportId : string <<FK reports>>
  * affectedCount : int
  * followerIds : string[] <<FK users>>
  * createdAt, updatedAt : timestamp
  resolvedAt, escalatedAt, closedAt : timestamp
  rating : int (1–5)
  feedback : string (≤300)
}
entity "reports/{id}/history/{id}" as history {
  * id <<PK>>
  --
  from : ReportStatus
  * to : ReportStatus
  * event : string
  * actorId, actorRole, actorName : string
  * note : string
  * at : timestamp
  .. append-only ..
}
entity "reports/{id}/comments/{id}" as comments {
  * id <<PK>>
  --
  * authorId <<FK users>>
  * authorRole, text : string
  * createdAt : timestamp
}
entity "publicReports/{id}" as pub {
  * id <<PK, = report id>>
  --
  ref, categoryId, status, suburb
  location : {lat,lng} ≈100 m
  affectedCount, isOpen, createdAt
  .. no PII ..
}
entity "tasks/{id}" as tasks {
  * id <<PK>>
  --
  * reportId <<FK reports>>
  * workerId <<FK users>>
  * assignedBy <<FK users>>
  * departmentId <<FK departments>>
  * priority, status : enum
  notes, completionNotes : string
  * proofIds : string[] <<FK photos>>
  * assignedAt : timestamp
  acceptedAt, startedAt, completedAt, endedAt
}
entity "alerts/{id}" as alerts {
  * id <<PK>>
  --
  * type : AlertType
  * title (≤100), message (≤500)
  * targetSuburbs : string[]
  * createdBy <<FK users>>
  * isActive : boolean
  * recipientCount, readCount : int
  smsCount : int
  * createdAt, expiresAt : timestamp
}
entity "scheduledAlerts/{id}" as sched {
  * id <<PK, = alert id once published>>
  --
  * type, title, message, targetSuburbs
  * createdBy <<FK users>>
  * publishAt, expiresAt : timestamp
  * status : SCHEDULED|PUBLISHED|CANCELLED
  publishedAt : timestamp
  recipientCount : int
}
entity "smsOutbox/{id}" as sms {
  * id <<PK>>
  --
  * uid <<FK users>>
  * alertId <<FK alerts>>
  * to : string (E.164)
  * body : string (≤160)
  * status : QUEUED|SENT|SIMULATED|FAILED
  * gateway : string
  providerId, error : string
  * createdAt : timestamp
  sentAt : timestamp
}
entity "guestTransfers/{hash}" as gt {
  * hash <<PK, sha256(code)>>
  --
  * guestUid <<FK users>>
  * expiresAt : timestamp
  usedAt : timestamp
  claimedBy <<FK users>>
}
entity "rateLimits/{id}" as rl {
  * id <<PK, hash(address)+hour>>
  --
  * count : int
  * expiresAt : timestamp
}
entity "photos/{id}" as photos {
  * id <<PK>>
  --
  * reportId <<FK reports>>
  * ownerId <<FK users>>
  * kind : EVIDENCE|PROOF
  * contentType : string
  * data : bytes (≤700 KB)
  * createdAt : timestamp
}
entity "alerts/{id}/recipients/{uid}" as rec {
  * uid <<PK, FK users>>
  --
  * alertId <<FK alerts>>
  * channel : IN_APP
  * deliveredAt : timestamp
  readAt : timestamp
}
entity "departments/{id}" as dept {
  * id <<PK, slug>>
  --
  * name, nameLower <<unique>>
  * slaHours : int (1–720)
  * isActive : boolean
}
entity "categories/{id}" as cat {
  * id <<PK, slug>>
  --
  * name, nameLower <<unique>>
  * icon : string
  * departmentId <<FK departments>>
  * isActive : boolean
}
entity "counters/reports-{year}" as counter {
  * next : int
}
entity "users/{uid}/pushTokens/{hash}" as push {
  * hash <<PK, sha256(token)>>
  --
  * uid <<FK users>>
  * token : string
  * createdAt : timestamp
}
entity "settings/app" as settings {
  * reportsPerHour : int (1–100)
}
entity "systemLogs/{id}" as logs {
  * level, source, message
  actorId, createdAt
}

users ||--o{ notif
users ||--o{ push
users ||--o{ reports : reporterId
reports ||--|{ history
reports ||--o{ comments
reports ||--|| pub
reports ||--o{ tasks : reportId
users ||--o{ tasks : workerId
reports |o--o{ reports : parentReportId
dept ||--o{ cat
dept ||--o{ reports
cat ||--o{ reports
alerts ||--o{ rec
users ||--o{ rec
users ||--o{ alerts : createdBy
dept ||--o{ users : departmentId
sched |o--o| alerts : published as
alerts ||--o{ sms
users ||--o{ sms
reports ||--o{ photos
tasks ||--o{ photos : proofIds
users ||--o{ gt : guestUid
@enduml
