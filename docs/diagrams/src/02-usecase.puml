@startuml usecase
!include _style.iuml
title CivicLink: Use Cases (Final Release)
left to right direction
skinparam packageStyle rectangle

actor Resident as R
actor "Public\n(no account)" as P
actor "Scheduler\n(system clock)" as S

rectangle CivicLink {
  package "Reporting & tracking" {
    usecase "Register (FR-01)" as UC1
    usecase "Sign in: password or Google;\nreset password\n(FR-02, FR-29, FR-30)" as UC2
    usecase "Edit my profile (FR-31)" as UC24
    usecase "Delete my account,\nPOPIA (FR-32)" as UC25
    usecase "Submit incident report\n(FR-03, FR-04)" as UC3
    usecase "Detect duplicate (FR-05)" as UC4
    usecase "Track my reports (FR-06)" as UC5
    usecase "Confirm (with rating) /\nreopen resolution\n(FR-14, FR-37)" as UC6
    usecase "View community map (FR-07)" as UC7
    usecase "View suburb alerts (FR-17)" as UC8
    usecase "Receive notifications:\nin-app and push\n(FR-15, FR-24)" as UC9
    usecase "Me too: confirm an\nopen issue (FR-33)" as UC27
    usecase "Install app / use offline\n(FR-34)" as UC28
    usecase "Save report offline,\nsend on reconnect (FR-27)" as UC29
    usecase "Opt in to SMS for\nemergency alerts (FR-25)" as UC30
    usecase "View transparency page\n(FR-36)" as UC31
  }
  package "Operations" {
    usecase "Manage report queue\n(FR-08, FR-26)" as UC13
    usecase "Triage / reject (FR-09)" as UC10
    usecase "Assign / reassign\nfield worker (FR-10, FR-12)" as UC11
    usecase "Bulk-assign reports\n(FR-35)" as UC32
    usecase "Escalate report (FR-13)" as UC12
    usecase "Broadcast alert now or\nschedule / cancel;\nSMS for emergencies\n(FR-16, FR-28, FR-25)" as UC14
    usecase "Review alert delivery (FR-18)" as UC15
    usecase "View analytics (FR-19)" as UC16
    usecase "Add internal note (FR-22)" as UC17
    usecase "Auto-escalate overdue /\nauto-close resolved /\npublish scheduled alerts\n(FR-13, FR-14, FR-28)" as UC23
  }
  package "Field work" {
    usecase "Accept / start task (FR-11)" as UC18
    usecase "Complete task with\nproof (FR-11)" as UC19
  }
  package "Administration" {
    usecase "Manage users and roles (FR-20)" as UC20
    usecase "Configure departments\nand categories (FR-21)" as UC21
    usecase "View system log (FR-23)" as UC22
    usecase "Set report limit (BR-21)" as UC26
  }
}

actor "Official" as O
actor "Field Worker" as W
actor Administrator as A
O <|-- A

R --> UC1
R --> UC2
R --> UC3
UC3 .> UC4 : <<include>>
R --> UC5
R --> UC6
R --> UC7
R --> UC8
R --> UC9
R --> UC24
R --> UC27
R --> UC28
R --> UC25
R --> UC29
R --> UC30
R --> UC31
P --> UC31
S --> UC23
UC3 <.. UC29 : <<extend>>

UC2 <-- O
UC24 <-- O
UC13 <-- O
UC10 <-- O
UC11 <-- O
UC32 <-- O
UC32 .> UC11 : <<include>>
UC12 <-- O
UC14 <-- O
UC15 <-- O
UC16 <-- O
UC17 <-- O
UC7 <-- O
UC9 <-- O
UC2 <-- W
UC18 <-- W
UC19 <-- W
UC17 <-- W
UC9 <-- W
UC20 <-- A
UC21 <-- A
UC22 <-- A
UC26 <-- A
@enduml
