@startuml context
!include _style.iuml
title CivicLink: System Context
left to right direction

actor "Resident" as R
actor "Municipal Official" as O
actor "Field Worker" as W
actor "Administrator" as A
actor "Public\n(no account)" as P

rectangle "CivicLink system boundary" as SYS #ffffff {
  rectangle "**CivicLink**\nWeb application (React PWA)\nNode.js command API\nCloud Firestore (data + photos)\nFirebase Authentication" as C #d5ebf4
}

cloud "Google sign-in\n(identity provider)" as G #f1f5f9
cloud "Firebase Cloud Messaging\n(web push delivery)" as FCM #f1f5f9
cloud "OpenStreetMap\ntile servers" as OSM #f1f5f9
node "GitHub Actions\n(hourly scheduler)" as GHA #f1f5f9
node "Device GPS /\nbrowser geolocation" as GPS #f1f5f9
cloud "SMS gateway (Twilio)\n(optional)" as SMS #f1f5f9
cloud "Vercel CDN\n(edge cache)" as CDN #f1f5f9

R --> C : register, sign in;\nreport incident (location, photos;\nonline or saved offline);\n"me too"; confirm with rating / reopen;\nSMS opt-in
C --> R : reference number, status updates,\nnotifications, suburb alerts, map
O --> C : triage, reject, assign (single/bulk),\nescalate; broadcast or schedule alerts
C --> O : report queue, new-report notifications,\nanalytics, delivery/read counts
W --> C : accept, start, complete\n(notes + proof photos)
C --> W : assigned tasks, incident details,\nlocation
A --> C : manage users, roles,\ndepartments, categories, limits
C --> A : audit log, maintenance results
C <..> G : OAuth sign-in (ID token)
C ..> FCM : push messages
FCM ..> R : push notifications
C ..> OSM : map tiles (HTTPS)
GHA ..> C : hourly SLA escalation /\nauto-close / scheduled alerts (secret)
GPS ..> C : coordinates (with consent)
C ..> SMS : emergency alerts
SMS ..> R : SMS
P --> CDN : transparency page
CDN ..> C : public figures\n(cached ≤ 5 min)
@enduml
