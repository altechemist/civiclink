@startuml architecture
!include _style.iuml
title CivicLink: Logical Architecture

actor "Resident /\nField Worker\n(mobile browser)" as M
actor "Official /\nAdministrator\n(desktop browser)" as D

package "Web client: apps/web (React SPA)" {
  [Role-guarded routes\n(RequireRole)] as Routes
  [Pages: resident · official ·\nworker · admin] as Pages
  [AuthProvider\n(claims, profile)] as AuthP
  [api.call()\n(typed callables)] as Api
  [Live hooks\n(onSnapshot)] as Hooks
  [Leaflet map /\nRecharts] as Viz
}

package "Shared domain: packages/shared" as Shared {
  [Schemas (zod)] as Sch
  [ReportStateMachine /\nTaskStateMachine] as SMs
  [DuplicatePolicy · SlaPolicy ·\nResolutionPolicy · analytics] as Pol
}

package "Firebase (emulator locally, africa-south1 in cloud)" {
  [Firebase Authentication\n(custom claims: role, dept,\nsuburb, active)] as Auth
  package "Cloud Functions: functions/" {
    [command() wrapper\nauth · role · validation · errors] as Cmd
    [ReportService · TaskService ·\nAlertService · UserService ·\nConfigService · CommentService ·\nAnalyticsService] as Svc
    [MaintenanceService\n(scheduled: escalate, auto-close)] as Sched
  }
  database "Cloud Firestore\n+ Security Rules" as FS
  database "Cloud Storage\n+ Storage Rules" as ST
}
cloud "OpenStreetMap tiles" as OSM

M --> Routes
D --> Routes
Routes --> Pages
Pages --> Api : commands
Pages --> Hooks : queries
Pages --> Viz
AuthP --> Auth : sign in, ID token
Api --> Cmd : HTTPS callable + ID token
Hooks --> FS : real-time listeners (read-only)
Pages --> ST : photo upload / download
Viz --> OSM : tiles
Cmd --> Svc
Svc --> FS : transactions (TX-1..3)
Svc --> ST : verify uploads
Svc --> Auth : create users, set claims
Sched --> FS
Pages ..> Sch : client validation
Svc ..> Sch : server validation
Svc ..> SMs
Svc ..> Pol
Pages ..> SMs : show only valid actions
@enduml
