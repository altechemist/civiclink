@startuml architecture
!include _style.iuml
title CivicLink: Logical Architecture

actor "Resident /\nField Worker\n(mobile browser)" as M
actor "Official /\nAdministrator\n(desktop browser)" as D
actor "Public\n(no account)" as PUB

package "Web client: apps/web (React SPA)" {
  [Role-guarded routes\n(RequireRole)] as Routes
  [Pages: resident · official ·\nworker · admin] as Pages
  [AuthProvider\n(claims, profile)] as AuthP
  [api.call()\n(typed callables)] as Api
  [Live hooks\n(onSnapshot)] as Hooks
  [Leaflet map /\nRecharts] as Viz
  [Offline outbox\n(IndexedDB)] as Outbox
  [Public home ·\ntransparency page\n(no sign-in)] as Transp
}

package "Shared domain: packages/shared" as Shared {
  [Schemas (zod)] as Sch
  [ReportStateMachine /\nTaskStateMachine] as SMs
  [DuplicatePolicy · SlaPolicy ·\nResolutionPolicy · analytics] as Pol
}

package "Command API: functions/ (Node.js 22)" {
  [Adapters:\nhttp.ts on Vercel (deployed)\nindex.ts Cloud Functions (local)] as Adapt
  [commands.ts registry +\nexecute(): auth · role ·\nvalidation · errors] as Cmd
  [ReportService · TaskService ·\nAlertService · UserService ·\nConfigService · CommentService ·\nAnalyticsService · photoService] as Svc
  [MaintenanceService\n(escalate, auto-close,\npublish scheduled alerts)] as Sched
  [PublicStatsService ·\nPublicFeedService\n(figures, alerts + open issues;\nper-instance cache)] as Stats
  [GuestService\n(guest sessions, upgrade,\ntransfer)] as Guest
  [smsService\n(SmsGateway)] as Sms
}
package "Firebase (Spark plan; emulator locally)" {
  [Firebase Authentication\n(password, Google, anonymous guests;\nclaims: role, dept, suburb, active, guest)] as Auth
  database "Cloud Firestore + Security Rules\n(incl. photos as binary documents)" as FS
}
[GitHub Actions hourly /\nVercel Cron daily] as Cron
cloud "OpenStreetMap tiles" as OSM
cloud "Firebase Cloud Messaging\n(web push)" as FCM
[Service worker sw.js\n(offline shell, map tiles,\npush display)] as SW
cloud "Vercel CDN\n(edge cache)" as CDN
cloud "Twilio SMS\n(optional)" as TW

M --> Routes
D --> Routes
Routes --> Pages
Pages --> Api : commands
Pages --> Hooks : queries
Pages --> Viz
AuthP --> Auth : sign in, ID token
Api --> Adapt : HTTPS callable protocol\n+ ID token
Adapt --> Cmd
Cron --> Adapt : /api/cron/maintenance\n(secret)
Hooks --> FS : real-time listeners (read-only)
Pages ..> FS : photos (read, rules-checked)
Viz --> OSM : tiles
Cmd --> Svc
Svc --> FS : transactions (TX-1..3)
Svc --> Auth : create users, set claims
Cmd --> Sched
Sched --> FS
Svc --> FCM : push after commit
FCM --> SW : push event
Pages ..> SW : registers (PWA)
Pages --> Outbox : save offline
Outbox --> Api : send on reconnect\n(clientId)
PUB --> Transp
Transp --> CDN : GET /api/public/feed,\n/api/public/stats
CDN --> Adapt : on cache miss
Adapt --> Stats
Stats --> FS : aggregate reads
Cmd --> Guest
Guest --> Auth : anonymous users,\nclaims, link/upgrade
Svc --> Sms
Sms --> TW : emergency SMS
Pages ..> Sch : client validation
Svc ..> Sch : server validation
Svc ..> SMs
Svc ..> Pol
Pages ..> SMs : show only valid actions
@enduml
