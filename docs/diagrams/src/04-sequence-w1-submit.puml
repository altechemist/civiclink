@startuml sequence-w1
!include _style.iuml
title W1: Submit incident report, sequence (TX-1)
autonumber

actor Resident
participant "NewReportPage\n(React)" as UI
participant "Command API\n(http.ts on Vercel /\nCloud Functions locally)" as API
participant "execute()\n+ ReportService" as RS
participant "photoService" as PS
participant "DuplicatePolicy\n(shared)" as DP
database "Firestore" as DB

Resident -> UI : complete steps 1–3, Submit
UI -> UI : submitReportSchema.safeParse()
alt client validation fails
  UI --> Resident : field errors (no request sent)
else valid
  UI -> UI : compressPhoto() each photo\n(≤ 1280 px, ≤ 700 KB JPEG)
  UI -> API : POST submitReport {data, photos: base64}\n+ Firebase ID token
  API -> API : verify ID token (revocation checked)
  API -> RS : execute(submitReport, caller, data)
  RS -> DB : get users/{uid}
  alt not an active RESIDENT
    RS --> UI : permission-denied
  else
    RS -> RS : parse(submitReportSchema)
    RS -> PS : decodePhotos(): size ≤ 700 KB,\nreal type = declared type (magic bytes)
    alt invalid input or photo
      RS --> UI : invalid-argument {fields}
      UI --> Resident : field errors
    else
      RS -> DB : pre-reads outside the transaction:\nsettings, profile, count(recent reports)
      alt over hourly limit (BR-21)
        RS --> UI : resource-exhausted
      else
        RS -> DB : runTransaction
        activate DB
        RS -> DB : get category, department
        RS -> DB : query reports by geohash ranges (100 m)
        RS -> DP : findParent(new, candidates, now)
        DP --> RS : parent | null
        RS -> DB : get counters/reports-YYYY
        RS -> DB : set counter, report, history,\nphotos/{id} (binary)
        alt duplicate
          RS -> DB : update parent (affectedCount+1, followerIds)
        else new report
          RS -> DB : set publicReports/{id},\nusers/{official}/notifications
        end
        DB --> RS : commit (retried on contention)
        deactivate DB
        RS --> API : {reportId, ref, duplicateOf}
        API --> UI : {result}
        UI --> Resident : reference number or "already reported"
        DB -->> UI : onSnapshot: officials' queues update live
      end
    end
  end
end
@enduml
