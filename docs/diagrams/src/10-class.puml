@startuml class
!include _style.iuml
title CivicLink: Application Class Design (implemented)
hide empty members


package "Domain entities (shared models → Firestore documents)" {
  class User <<users>> {
    uid: string
    name: string
    email: string
    phone?: string
    role: Role
    departmentId?: string
    suburb?: Suburb
    smsAlerts?: boolean
    isActive: boolean
    createdAt, lastLoginAt
  }
  class Report <<reports>> {
    id: string
    ref: string  «CL-YYYY-NNNN»
    reporterId, reporterName
    categoryId, departmentId
    description: string
    location: LatLng
    geohash: string
    suburb, landmark?
    severity: Severity
    photoIds: string[]
    status: ReportStatus
    assignedWorkerId?, activeTaskId?
    parentReportId?, affectedCount
    followerIds: string[]
    resolutionNotes?, resolutionPhotoIds
    rating?: 1..5, feedback?
    createdAt, resolvedAt?, escalatedAt?, closedAt?
  }
  class HistoryEntry <<reports/{id}/history>> {
    from: ReportStatus?
    to: ReportStatus
    event: string
    actorId, actorRole, actorName
    note: string
    at: Timestamp
  }
  class Task <<tasks>> {
    id, reportId, reportRef
    workerId, assignedBy
    departmentId, priority: Severity
    status: TaskStatus
    notes?, completionNotes?
    proofIds: string[]
    assignedAt, acceptedAt?, startedAt?, completedAt?
  }
  class Alert <<alerts>> {
    type: AlertType
    title, message
    targetSuburbs: string[]
    isActive: boolean
    recipientCount, readCount, smsCount?
    createdAt, expiresAt
  }
  class ScheduledAlert <<scheduledAlerts>> {
    type, title, message, targetSuburbs
    publishAt, expiresAt
    status: SCHEDULED | PUBLISHED | CANCELLED
    publishedAt?, recipientCount?
  }
  class SmsMessage <<smsOutbox>> {
    uid, to: E.164, body ≤ 160
    alertId
    status: QUEUED | SENT | SIMULATED | FAILED
    gateway, providerId?, error?
  }
  class AlertRecipient <<alerts/{id}/recipients>> {
    uid, alertId
    channel: IN_APP
    deliveredAt, readAt?
  }
  class Notification <<users/{uid}/notifications>> {
    type, title, body, link
    readAt?, createdAt
  }
  class Department <<departments>> {
    name, slaHours: int, isActive
  }
  class Category <<categories>> {
    name, icon, departmentId, isActive
  }
  class Comment <<reports/{id}/comments>> {
    authorId, authorRole, text, createdAt
  }
  class PushToken <<users/{uid}/pushTokens>> {
    uid, token, createdAt
  }
  class Settings <<settings/app>> {
    reportsPerHour: int
  }
  class Photo <<photos>> {
    reportId, ownerId
    kind: EVIDENCE | PROOF
    contentType, size
    data: bytes (≤ 700 KB)
  }
  class PublicReport <<publicReports>> {
    ref, categoryId, status
    location «≈100 m», suburb
    affectedCount, isOpen
  }
}

package "Domain logic (packages/shared)" {
  class ReportStateMachine <<module>> {
    +next(from, event, actor): ReportStatus
    +can(from, event, actor): boolean
    +eventsFrom(status, actor): ReportEvent[]
  }
  class TaskStateMachine <<module>> {
    +next(from, event): TaskStatus
    +can(from, event): boolean
  }
  class DuplicatePolicy <<module>> {
    radiusM = 100
    windowMs = 72 h
    +isMatch(new, candidate, now): boolean
    +findParent(new, candidates, now): Candidate?
  }
  class SlaPolicy <<module>> {
    +isBreached(report, slaHours, now): boolean
  }
  class ResolutionPolicy <<module>> {
    +withinWindow(resolvedAt, now): boolean
    +shouldAutoClose(report, now): boolean
  }
}

package "Application services (functions/src/services)" {
  class ReportService {
    -clock: () => number
    +submit(input, actor)  «TX-1, idempotent by clientId»
    +triage(input, actor)
    +reject(input, actor)
    +escalate(input, actor)
    +assign(input, actor)  «TX-2»
    +assignMany(input, actor)  «TX-2 per report»
    +reassign(input, actor)
    +confirm(input, actor)  «with rating»
    +reopen(input, actor)
    +affirm(reportId, actor)
  }
  class TaskService {
    +update(input, actor)
    +complete(input, actor)  «TX-3»
  }
  class ReportLifecycle <<module>> {
    +applyTransition(tx, args): ReportStatus
    +assertDepartmentAccess(actor, deptId)
  }
  class NotificationService <<module>> {
    +add(tx, recipients, n, now)
    +departmentOfficials(tx, deptId)
  }
  class AlertService {
    +broadcast(input, actor)  «now or scheduled»
    +publishDue(): number
    +cancelScheduled(id, actor)
    -publish(alertId, content, now)
    +deactivate(alertId)
    +markRead(alertId, actor)
  }
  class UserService {
    +registerResident(input)
    +createStaff(input, actor)
    +setRole(input, actor)
    +setActive(uid, active, actor)
    +completeProfile(uid, input)
    +updateProfile(input, actor)
    +deleteMyAccount(actor)
  }
  class ConfigService {
    +upsertDepartment(input, actor)
    +upsertCategory(input, actor)
    +updateSettings(input, actor)
  }
  class MaintenanceService {
    +runAll(): {escalated, closed, published}
    +escalateOverdue(): number
    +autoCloseResolved(): number
  }
  class AnalyticsService {
    +summary(days): AnalyticsSummary
  }
  class CommentService {
    +add(reportId, text, actor)
  }
  class PublicStatsService {
    -cached: PublicStats  «1 min»
    +get(): PublicStats
  }
  class smsService <<module>> {
    +sendAlertSms(alertId, alert, recipients, now)
    +setSmsGateway(g)
  }
  interface SmsGateway {
    +send(to, body): {id, simulated?}
  }
  class CommandRegistry <<commands.ts>> {
    +COMMANDS: Record<name, CommandDefinition>
    +execute(def, caller, data)
    -loadActor(uid): Actor
    -parse(schema, data)
    -toHttpsError(err)
  }
  class HttpAdapter <<http.ts, Vercel>> {
    +handleHttp(req, res)
    -verifyCaller(): Caller
    -maintenance(): cron
    -stats(): GET /api/public/stats
    -publishDueAlertsInBackground()
  }
  class CallableAdapter <<index.ts, Cloud Functions>> {
    +command(def): onCall
  }
  class pushService <<module>> {
    +recordPush(intent)
    +withPushScope(fn): {result, intents}
    +deliverPushes(intents)
    +PushTokens.register / unregister
  }
  class photoService <<module>> {
    +decodePhotos(inputs, field): DecodedPhoto[]
    +writePhotos(tx, photos, meta, now): ids
  }
}

User "1" -- "0..*" Report : submits >
User "1" -- "0..*" Task : is assigned >
Report "1" *-- "1..*" HistoryEntry : audited by >
Report "1" *-- "0..*" Comment
Report "1" -- "0..*" Task : generates (≤1 active) >
Report "0..*" -- "0..1" Report : duplicate of >
Report "1" -- "1" PublicReport : projected as >
Report "1" *-- "0..*" Photo : evidence / proof >
Category "0..*" --> "1" Department : routes to >
Report "0..*" --> "1" Category
Report "0..*" --> "1" Department
Alert "1" *-- "0..*" AlertRecipient
User "1" -- "0..*" AlertRecipient
User "1" *-- "0..*" Notification
User "1" *-- "0..*" PushToken : devices >
User "1" -- "0..*" Alert : creates >

ScheduledAlert "1" -- "0..1" Alert : published as (same id) >
Alert "1" -- "0..*" SmsMessage : emergency SMS >
User "1" -- "0..*" SmsMessage : receives >
HttpAdapter ..> CommandRegistry
HttpAdapter ..> PublicStatsService
HttpAdapter ..> AlertService : background publishDue
MaintenanceService ..> AlertService : publishDue
AlertService ..> smsService
smsService ..> SmsGateway
AlertService ..> ScheduledAlert
smsService ..> SmsMessage
CallableAdapter ..> CommandRegistry
CommandRegistry ..> ReportService
CommandRegistry ..> TaskService
CommandRegistry ..> AlertService
CommandRegistry ..> UserService
CommandRegistry ..> ConfigService
CommandRegistry ..> CommentService
CommandRegistry ..> AnalyticsService
ReportService ..> ReportLifecycle
TaskService ..> ReportLifecycle
MaintenanceService ..> ReportLifecycle
ReportLifecycle ..> ReportStateMachine
ReportLifecycle ..> NotificationService
NotificationService ..> pushService : records intents
CommandRegistry ..> pushService : flush after commit
TaskService ..> TaskStateMachine
ReportService ..> DuplicatePolicy
ReportService ..> photoService
TaskService ..> photoService
MaintenanceService ..> SlaPolicy
MaintenanceService ..> ResolutionPolicy
ReportService ..> ResolutionPolicy
ReportService ..> Report
TaskService ..> Task
AlertService ..> Alert
UserService ..> User
ReportService ..> Settings : reads limit (BR-21)
@enduml
