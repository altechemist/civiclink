# Web app (apps/web/.env.local). Values below work with the local emulator as-is.
VITE_FIREBASE_PROJECT_ID=demo-civiclink
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-civiclink.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-civiclink.appspot.com
VITE_FIREBASE_APP_ID=demo-app-id
VITE_USE_EMULATORS=true
# For a real Firebase project, set VITE_USE_EMULATORS=false and use the project's web config.
# Never commit real keys or service-account files.

# ---- Deployment on Vercel + Firebase Spark (ADR-0006) ----
# Web (build-time, public):
#   VITE_USE_EMULATORS=false
#   VITE_API_BASE=/api
#   VITE_FIREBASE_PROJECT_ID / VITE_FIREBASE_API_KEY / VITE_FIREBASE_AUTH_DOMAIN / VITE_FIREBASE_APP_ID  (Firebase web app config)
# API (server-side secrets; set in Vercel, never commit):
#   FIREBASE_SERVICE_ACCOUNT=<service-account JSON, or base64 of it>
#   CRON_SECRET=<long random string>
#   ALLOWED_ORIGINS=https://<your-app>.vercel.app   (only needed if the API is called cross-origin)
#   VITE_FIREBASE_VAPID_KEY=<Web Push public key>     (build-time, public; enables web push, FR-24)
# Optional real SMS for emergency alerts (FR-25); without these, SMS are recorded as SIMULATED:
#   TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   TWILIO_AUTH_TOKEN=<secret>
#   TWILIO_FROM=+1xxxxxxxxxx   (your Twilio number, E.164)
